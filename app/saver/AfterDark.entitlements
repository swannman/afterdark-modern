<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shared with the AfterDark app so the saver can read the downloaded asset
         paths the app publishes (ADGroupHandoff). Same team as the app. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.afterdark.modern</string>
    </array>
    <!-- Dev: allow the harness/debugger to attach to the loaded bundle. -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
