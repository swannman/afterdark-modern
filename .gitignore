# --- build products ---
.DS_Store
*.xcuserstate
build/
DerivedData/
app/AfterDark/.build/
*.app/

# --- compiled hosts / tools (built by `make` from source) ---
engine/adhost
engine/adhost68k
tools/adblit/adblit
app/saver/AfterDark.saver/
app/saver/cshim/shim.o

# --- ORIGINAL After Dark bits — never commit (fetched locally by tools/adfetch) ---
