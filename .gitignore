engine/ADShared40.pef
engine/AD4Library.rsrc
# Anything adfetch downloads / extracts:
**/.adfetch-downloads/
# Extracted original assets are never committed:
app/AfterDark/Sources/AfterDarkKit/Resources/*/
!app/AfterDark/Sources/AfterDarkKit/Resources/catalog.json
assets/

# --- reverse-engineering artifacts derived from original code (do not publish) ---
research/
tools/scratchpad/

